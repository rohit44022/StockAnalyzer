backtest_deep_results.json
backtest_full_results.json
backtest_pa_results.json
backtest_results.json
simulation_results.json

# ── Pip installer ──
get-pip.py

# ── Excel exports ──
*.xlsx

# ── Tickers cache (generated on download) ──
tickers_cache.json

# ── AI tool / skills directories (local config, not source) ──
.agents/
.claude/
.codex/
.impeccable/
.token-optimizer/
skills-lock.json

# ── Generated cache files ──
bb_squeeze/cache/
logs/*.pkl
logs/backtest_*.csv


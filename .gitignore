ai_ml/models/regime_cluster.joblib
ai_ml/models/training_data.parquet
ai_ml/models/signal_filter_*.joblib
backtest_bb_kc_results.json
backtest_triple_results.json

# ── Research / scratch scripts (prefixed with _) ──
_backtest_*.py
_research_*.py
_research_*_results.csv

# ── Graphify output (generated, rebuild with `graphify update .`) ──
graphify-out/

# ── RenTech ML models (generated, large) ──
rentech/models/*.joblib

# ── Forge config (local AI tool) ──
forge.yaml
